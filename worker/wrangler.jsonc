{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolboxpro-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toolboxpro",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_KEY": "toolbox-android"
  },
  "observability": {
    "enabled": true
  }
}
